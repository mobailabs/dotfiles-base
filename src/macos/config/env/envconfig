# 通用环境配置（非敏感），会被链接到 ~/.envconfig
#
# 注意：请在这里（envconfig）加载本地覆盖文件，而不是在 zshrc 里做这件事。
# 例如：
# export HTTP_PROXY=""
# export HTTPS_PROXY=""

# ⚠️ 不要在这里写死 `export TERM=...`。
#
# 终端会自己设 TERM（Ghostty 设 `xterm-ghostty`，iTerm 设 `xterm-256color`…），
# 写死会把终端的专有 terminfo 覆盖掉：
#   - Ghostty 下丢掉 xterm-ghostty，tmux 的 `terminal-overrides ",ghostty:Tc"`
#     就永远匹配不上（进 tmux 时外层 TERM 已经不是 ghostty 了）；
#   - 反过来，在非 Ghostty 终端里也会被错标成 ghostty 的假设。
# 只在 TERM **完全为空**（极端异常，比如某些 cron/daemon 上下文）时才兜底。
if [[ -z "${TERM:-}" ]]; then
  export TERM=xterm-256color
fi

# Local env overlay (private/machine-specific)
# If you use the private template, it will link ~/.envconfig.local for you.
if [[ -f ~/.envconfig.local ]]; then
  source ~/.envconfig.local
fi

alias pyv='python3 -m venv .venv'
alias pya='source .venv/bin/activate'
alias pyd='deactivate'
alias pyi='pip install -r requirements.txt'
