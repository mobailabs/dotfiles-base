# Neo-Geometric Dark (冷青极客风)
# 主色: #32ade6 | 亮青: #5ac8fa | 背景: #1c1c1e | 前景: #f2f2f7
#
# 这是唯一的 ghostty 配置，没有主题切换：直接改这里。
#
# 注：tmux 状态栏用的是另一套 Monokai Pro Ristretto 暖色板（主色 #FC9867）。
# 两者不是同一套配色，只是都偏深色。要统一就改各自的文件（终端在这里，
# tmux 在 src/macos/config/tmux/config/tmux.conf）。

# ---- 主题配色 ----
background = #1c1c1e
foreground = #f2f2f7

selection-background = #3a3a3c
selection-foreground = #ffffff

# 光标配色（用主色）
cursor-color = #32ade6
cursor-text = #ffffff

# ANSI 16 色（深灰基底 + 冷青主色）
# 0-7: 普通; 8-15: 亮色
palette = 0=#1c1c1e
palette = 1=#ff453a
palette = 2=#30d158
palette = 3=#ffd60a
palette = 4=#32ade6
palette = 5=#bf5af2
palette = 6=#5ac8fa
palette = 7=#f2f2f7
palette = 8=#636366
palette = 9=#ff6961
palette = 10=#40e57c
palette = 11=#ffe066
palette = 12=#64d2ff
palette = 13=#d684f7
palette = 14=#64d2ff
palette = 15=#ffffff

# ---- Ghostty 行为 ----
# 行高拉高 8%：给 p10k 的 powerline 分隔符（\ue0b0 那类）留余地。
# ⚠️ 如果装完 p10k 发现分隔符行间有缝/被裁，把这里调到 12% 或整条删掉。
adjust-cell-height = 8%

# 默认不自动进入 tmux。想进就手动跑 `tal` / `tcd`（见 aliases.sh），
# 或把这条改成 `command = /bin/zsh -l -c 'tal'` 之类的自动入口。

# 剪贴板与选择
copy-on-select = clipboard
# 显式允许程序通过 OSC 52 写入系统剪贴板
clipboard-write = allow
# 鼠标选择：常态鼠标事件归 tmux（见 tmux.conf 的 `mouse on`），拖选由 tmux
# 在 copy-mode 里完成、经 OSC 52 写系统剪贴板。
# `never` = 按住 Shift **强制用终端自己的选区**，tmux 抢不走 —— 这是「绕开
# tmux 选屏幕文字」的逃生舱（选状态栏/边框、跨 pane 的纯屏幕文字、tmux 卡住
# 时兜底都会用到）。用 true 的话 Shift 会发给 tmux，逃生舱就失效了。
mouse-shift-capture = never

# ---- 字体 ----
# 主字体 = 等宽英文（代码）；第二个 = 中文回退（fallback）。
#
# JetBrainsMono Nerd Font Mono：几何感、方正转角，接近 Berkeley Mono 的气质；
#   Nerd Font 补丁版 → p10k 的 git/目录图标开箱即用。用 **Mono** 变体：
#   它把所有字形（含图标）都压进单格，终端里不会错位 —— 非 Mono 的 "NF"
#   变体字形宽窄不一，终端会串行。brew cask `font-jetbrains-mono-nerd-font`。
#
# Xiaolai Mono（小赖字体等宽，LXGW 作者的 CJK 手写体，源自濑户字体）：
#   只有 Regular 一档，**只当中文回退** —— 英文不是它的强项。
#   brew cask `font-xiaolai-mono`。字体内部家族名就是 `Xiaolai Mono`
#   （cask 显示名是 `Xiaolai Font Mono`，但 mac 按内部名匹配，所以写前者）。
#
# ⚠️ ⚠️ ghostty 的 font-family **不能用逗号列表**！它每个值整条是一个家族名，
#   逗号会被当成名字的一部分（见 ghostty 源码 RepeatableString 的注释），
#   结果一个都匹配不上、直接回退系统默认字体。多字体回退要**一行一个**：
#
#       font-family = 主字体
#       font-family = 回退字体
#
#   （原来的 `TX-02, LXGW WenKai` 就是这么写错的，已改。）
#
# ⚠️ 两个字体都由一键配置装（packages/macos/brew-cask.txt 的 Fonts 段）。
#   改字体要**两边一起改**：cask 清单换包，这里换家族名。
#   没装时 ghostty 静默回退到系统默认等宽字体，不报错。
font-family = JetBrainsMono Nerd Font Mono
font-family = Xiaolai Mono
font-size = 14
font-thicken = true
# 已有 font-thicken，避免过度加粗

# 斜杠零（JetBrainsMono 默认是点式零；斜杠零在终端里更易辨认）。
# 连字（=> != 等）默认就开（calt），这里不用再写。
font-feature = zero

mouse-hide-while-typing = true

# macOS 外观与窗口
# ⌘ 键行为：false = Option 保持 macOS 原生（Option+b 输 ∫）；
# 想当 Alt 用（tmux M-、readline Alt+b/f/d、nvim <M-…>）改成 left / true。
# 保持 false 是有意的 —— 中文输入用得上 Option 的组合。
macos-option-as-alt = false
# 只隐藏标题栏，**保留**原生边框与圆角。
# ⚠️ 不要再加 `window-decoration = false` —— 那个等价于 `none`，会把边框、
#    圆角**和标签页**一起干掉（macOS 系统强制）。两者是互斥的意图。
macos-titlebar-style = hidden
window-padding-color = extend
window-padding-balance = true

# 建议：避免保存旧缩放覆盖你改的字号
window-save-state = never

confirm-close-surface = false
macos-icon = custom
macos-custom-icon = ~/.config/ghostty/ghostty-white.icns

# 启动即最大化（全屏铺开）。原来在这里的两行 `window-width/height`
# 是死代码（maximize 之后它们不生效），已删。
maximize = true

# 渲染与观感优化
# 不设 alpha-blending：macOS 的平台默认是 `native`（Display P3），为这个
# 平台调过。ghostty 所有非 mac 平台默认才是 `linear-corrected`，那会做 gamma
# 校正（暗字变细、亮字变粗）—— 和这里的 font-thicken 叠加，文字容易发糊。
# 想要那个观感再加回：alpha-blending = linear-corrected。
background-opacity = 0.91
background-opacity-cells = true
macos-window-shadow = true
window-step-resize = true
unfocused-split-opacity = 0.85

# create ghostty window
keybind = super+shift+n=new_window

# ---- 快捷键（以 tmux 默认前缀 C-b 对齐：\x02）----
# 新窗口 / 窗口切换 1-9
keybind = super+t=text:\x02\x63
keybind = super+physical:one=text:\x02\x31
keybind = super+physical:two=text:\x02\x32
keybind = super+physical:three=text:\x02\x33
keybind = super+physical:four=text:\x02\x34
keybind = super+physical:five=text:\x02\x35
keybind = super+physical:six=text:\x02\x36
keybind = super+physical:seven=text:\x02\x37
keybind = super+physical:eight=text:\x02\x38
keybind = super+physical:nine=text:\x02\x39

# 面板导航（Vim hjkl）
keybind = super+h=text:\x02h
keybind = super+j=text:\x02j
keybind = super+k=text:\x02k
keybind = super+l=text:\x02l

# 分割：super+d 垂直（tmux -v, "），super+Enter 水平（tmux -h, %）
keybind = super+d=text:\x02\x22
keybind = super+enter=text:\x02\x25

# 关闭面板
keybind = super+w=text:\x02x

# 面板缩放/全屏切换
keybind = super+z=text:\x02z

# 窗口切换（上一个/下一个）
keybind = super+left_bracket=text:\x02p
keybind = super+right_bracket=text:\x02n

# 快速进入 tmux 复制模式
keybind = super+e=text:\x02[

# 切换到上一个活动面板
keybind = super+semicolon=text:\x02;

# 面板大小调整（Shift+HJKL）
keybind = super+shift+h=text:\x02H
keybind = super+shift+j=text:\x02J
keybind = super+shift+k=text:\x02K
keybind = super+shift+l=text:\x02L

# 同步面板输入
keybind = super+shift+i=text:\x02I

# 会话管理
keybind = super+n=text:\x02N
keybind = super+o=text:\x02S
keybind = super+shift+x=text:\x02X
keybind = super+p=text:\x02P

# 命令弹窗
keybind = super+r=text:\x02R

# 额外快捷键
# ⌘,  → tmux 内置 `,`（重命名窗口）；⌘⇧, → tmux 内置 `$`（重命名会话）
keybind = super+comma=text:\x02,
keybind = super+shift+comma=text:\x02$
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

# ⚠️ 上面这些 ⌘+单字母 会**盖掉** ghostty 里对应的 macOS 原生快捷键：
#   ⌘h 隐藏窗口 / ⌘w 关标签 / ⌘z 撤销 / ⌘n 新建 / ⌘p 打印 / ⌘r 刷新 …
# 这是为了让「⌘+hjkl 直接操作 tmux 面板」而做的取舍 —— 只在 ghostty
# 聚焦时生效，不影响其它 App。不想要某个就注释掉对应行。
