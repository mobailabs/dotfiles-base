# E-ink Grayscale Theme (墨水屏灰度主题)
# 纯白背景 + 纯黑前景，最大对比度
# 16 色 ANSI 映射为灰度阶梯，墨水屏上可区分

background = #ffffff
foreground = #000000
cursor-color = #000000
cursor-text = #ffffff
selection-background = #c0c0c0
selection-foreground = #000000

# ANSI 16 色 — 9 级灰度（每级间距 ~10%，避免白底白字和重复）
palette = 0=#000000
palette = 1=#1a1a1a
palette = 2=#4d4d4d
palette = 3=#333333
palette = 4=#666666
palette = 5=#4d4d4d
palette = 6=#808080
palette = 7=#e0e0e0
palette = 8=#333333
palette = 9=#1a1a1a
palette = 10=#666666
palette = 11=#4d4d4d
palette = 12=#999999
palette = 13=#808080
palette = 14=#b3b3b3
palette = 15=#cccccc
