[core]
    editor = vim
    filemode = false
    excludesfile = ~/.gitignore
    attributesfile = ~/.gitattributes
	autocrlf = input
	quotepath = false
	longpaths = true
	trustctime = false
	ignorecase = true
	untrackedcache = true

# so much color
[color]
    ui = auto
[color "diff"]
    meta = yellow bold
    commit = green bold
    frag = magenta bold
    old = red bold
    new = green bold
    whitespace = red reverse
    newMoved = cyan
    oldMoved = blue
[color "diff-highlight"]
    oldNormal = red bold
    oldHighlight = "red bold 52"
    newNormal = "green bold"
    newHighlight = "green bold 22"
[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green
[color "status"]
    added = yellow
    changed = green
    untracked = cyan

[merge]
    renameLimit = 0

[remote "origin"]
    #fetch = +refs/heads/*:refs/remotes/origin/*

[pull]
	rebase = false
[commit]
	gpgsign = false
[alias]
	gac = "!f() { git add -A && git commit -m \"$*\"; }; f"
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[safe]
	# ⚠️ 不要写 `directory = *` —— 那等于对所有目录关闭 git 的
	# dubious-ownership 防护（他人拥有的恶意仓库可执行其配置，
	# CVE-2022-24765 那类）。这里只放行你自己的地盘。
	directory = ~/dotfiles
	directory = ~/*
[init]
	defaultBranch = master
[http]
	postBuffer = 655360000
[diff "text"]
	textconv = cat
[mergetool]
	keepBackup = false
[lfs]
	concurrenttransfers = 32
	fetchrecentrefsdays = 0
	pruneoffsetdays = 0
	dialtimeout = 3
	tlstimeout = 3
[lfs "transfer"]
	maxretries = 1
	maxretrydelay = 2
[merge "lfs-text"]
	driver = git lfs merge-driver --ancestor %O --current %A --other %B --marker-size %L --output %A --program 'git merge-file --stdout --marker-size=%%L %%A %%O %%B >%%D'
[rebase]
	backend = merge
[log]
    date = format:%Y-%m-%d %H:%M:%S
[user]
	# 禁用自动探测身份：必须由用户显式提供 name/email
	# （git 自己会读 ~/.config/git/config），否则 commit 会以
	# 「Author identity unknown」失败。
	# 这是故意的 —— 防止换机器后拿主机名 / 系统用户名当邮箱提交出错。
	useConfigOnly = true

# 私有身份 —— name/email 从 ~/.gitconfig.local 读（**不进仓库**）。
#
# 为什么不直接写进上面 [user]：那样会被提交，公开仓库就泄露了邮箱，
# 而且换机器还要再改仓库源。放 ~/.gitconfig.local（用户自己的文件，
# 不在 dotfiles 里）既私有又能每台机器不同。
#
# ⚠️ 只有这一行 include，没有它 `.gitconfig.local` 就是死文件（曾发生过：
# 配了 name/email 却全局读不到，commit 用的是各仓库本地配置）。
# macview 的 Git 页可以就地编辑 ~/.gitconfig.local（私有 overlay）。
[include]
	path = ~/.gitconfig.local
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
