[core]
    editor = vim
    filemode = false
    excludesfile = ~/.gitignore
    attributesfile = ~/.gitattributes
	autocrlf = input
	quotepath = false
	longpaths = true
	trustctime = false
	ignorecase = true
	untrackedcache = true

# so much color
[color]
    ui = auto
[color "diff"]
    meta = yellow bold
    commit = green bold
    frag = magenta bold
    old = red bold
    new = green bold
    whitespace = red reverse
    newMoved = cyan
    oldMoved = blue
[color "diff-highlight"]
    oldNormal = red bold
    oldHighlight = "red bold 52"
    newNormal = "green bold"
    newHighlight = "green bold 22"
[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green
[color "status"]
    added = yellow
    changed = green
    untracked = cyan

[merge]
    renameLimit = 0

# use separate file for username / github token / etc
[include]
    path = ~/.gitconfig.local

[remote "origin"]
    #fetch = +refs/heads/*:refs/remotes/origin/*

# 身份与签名设置放在 ~/.gitconfig.local（私有的 overlay，不进仓库）。
#
# ⚠️ 必须自己建这个文件，否则**一次 commit 都提交不了**：
#   本文件末尾 `[user] useConfigOnly = true` 会禁用 git 的自动探测身份，
#   没有 name/email 时 git 直接拒绝 commit（Author identity unknown）。
#   这是刻意的 —— 防止换机器后拿主机名 / 系统用户名当邮箱提交出错。
#
# 建一次即可（两台机器各自建，内容不同也不进仓库）：
#   cat > ~/.gitconfig.local <<'EOF'
#   [user]
#       name = Your Name
#       email = your@email.com
#   EOF
#
# 需要 GPG 签名时再加：
#   [commit]
#       gpgsign = true
#   [gpg]
#       program = gpg        # 不写死路径，靠 PATH 找（brew 装在 /opt/homebrew 或 /usr/local）

[pull]
	rebase = false
[commit]
	gpgsign = false
[alias]
	gac = "!f() { git add -A && git commit -m \"$*\"; }; f"
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[safe]
	# ⚠️ 不要写 `directory = *` —— 那等于对所有目录关闭 git 的
	# dubious-ownership 防护（他人拥有的恶意仓库可执行其配置，
	# CVE-2022-24765 那类）。这里只放行你自己的地盘。
	directory = ~/dotfiles
	directory = ~/*
[init]
	defaultBranch = master
[http]
	postBuffer = 655360000
[diff "text"]
	textconv = cat
[mergetool]
	keepBackup = false
[lfs]
	concurrenttransfers = 32
	fetchrecentrefsdays = 0
	pruneoffsetdays = 0
	dialtimeout = 3
	tlstimeout = 3
[lfs "transfer"]
	maxretries = 1
	maxretrydelay = 2
[merge "lfs-text"]
	driver = git lfs merge-driver --ancestor %O --current %A --other %B --marker-size %L --output %A --program 'git merge-file --stdout --marker-size=%%L %%A %%O %%B >%%D'
[rebase]
	backend = merge
[log]
    date = format:%Y-%m-%d %H:%M:%S
[user]
	# 禁用自动探测身份：必须由 ~/.gitconfig.local 显式提供 name/email，
	# 否则 commit 会以「Author identity unknown」失败。
	# 这是故意的 —— 见上方 include 附近的说明。
	useConfigOnly = true
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
