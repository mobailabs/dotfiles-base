#!/usr/bin/env zsh

# ============================================
# .funcs - 自定义 shell 函数
# ============================================
# 由 ~/.zshrc 加载（`[[ -f ~/.funcs ]] && source ~/.funcs`）。
#
# 与 ~/.aliases 的分工：
#   aliases  → 一行命令的别名
#   funcs    → 需要参数、分支、循环的复杂函数
#
# 历史原因：这个文件曾经缺失，但 ~/.zshrc 一直在 source 它 ——
# 属于「加载了不存在的东西」的悬空加载点。现在补上。

# 例如：
# mkcd() {
#   mkdir -p "$1" && cd "$1"
# }
