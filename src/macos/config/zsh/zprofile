#!/usr/bin/env zsh

# ============================================
# .zprofile - 登录 Shell 配置
# ============================================
# 这个文件在登录 shell 时加载（在 .zshrc 之前）
# 适合设置一次性的环境初始化

# ============================================
# Homebrew 环境初始化
# ============================================
# 探测已收进 .zshenv（所有 shell 都会加载，且排在 .zprofile 之前）。
# 这里只负责把 brew 的 shell 集成（补全、man path 等）拉进来。
#
# 不重复写 /opt/homebrew 判断：HOMEBREW_PREFIX 由 .zshenv 设好。
if command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
fi
