#!/usr/bin/env zsh

# ============================================
# .zshenv - 核心环境变量配置
# ============================================
# 这个文件在所有 zsh 实例中都会加载（login/non-login, interactive/non-interactive）
# 适合设置 PATH 和核心环境变量
# 注意：不要在这里输出任何内容，会影响非交互式脚本

# ============================================
# 编辑器配置
# ============================================
export EDITOR=nvim
export VISUAL=nvim

# ============================================
# 语言和编码
# ============================================
export LC_ALL="en_US.UTF-8"
export LANG="en_US.UTF-8"

# ============================================
# PATH 配置 - 使用 typeset -U 确保路径唯一
# ============================================
typeset -U path  # 确保 PATH 中的路径不重复

# 用户自定义路径（跨平台）
#
# 一律加存在性判断。一个不存在的目录进 PATH 不会报错，但会让你以为那里有东西
# —— 这几行以前是无条件加的，`$HOME/.dotfiles/bin` 指向一个从来不存在的目录，
# 而且那个仓库名在本机根本不存在（真实路径是 ~/dotfiles）。
#
# **位置很重要**：这两个目录原本在 PATH 最前面，必须保持。
# 用 `path+=(...)` 追加到末尾会把优先级降到最低，结果是你自己装的 CLI
# 被系统里的同名命令遮住。所以下面用 _pre 攒好再整体前置。
#
# 私有源的 bin 不在这里处理：`~/.zshrc.local` 里已经用
# `$DOTFILES_PRIVATE_ROOT/bin` 条件加过了，那才是它的归属。
_pre=()
[[ -d "$HOME/.bin" ]] && _pre+=("$HOME/.bin")
[[ -d "$HOME/.local/bin" ]] && _pre+=("$HOME/.local/bin")
path=($_pre $path)
unset _pre

# 条件添加语言工具路径
[[ -d "$HOME/go/bin" ]] && path+=("$HOME/go/bin")
[[ -d "$HOME/.go/bin" ]] && path+=("$HOME/.go/bin")
[[ -d "$HOME/.cargo/bin" ]] && path+=("$HOME/.cargo/bin")

# tmux 工具路径
[[ -d "$HOME/.config/tmux/bin" ]] && path+=("$HOME/.config/tmux/bin")

# Bun 路径
[[ -d "$HOME/.bun/bin" ]] && path+=("$HOME/.bun/bin")

# npm / LM Studio CLI 路径
#
# 这里是**唯一**放它们的地方。以前 `.lmstudio/bin` 在 zshrc 里也加过一次，
# `.cache/lm-studio/bin` 则只在 bash_profile 里加 —— 同一个程序的位置散在
# 两套逻辑里（一套 zsh 的 `path+=` + typeset -U 去重，一套 bash 的手拼
# `$PATH:...` 完全不去重），加一处必漏一处。
#
# 放 .zshenv 而不是 .zshrc：所有 shell 都加载它，bash_profile 弹进 zsh 后
# 也一定能拿到（zshenv 排在 zshrc 之前）。
[[ -d "$HOME/.npm-global/bin" ]] && path+=("$HOME/.npm-global/bin")
# 两个历史路径都试：旧版 LM Studio 装在 .cache 下，新版装在 .lmstudio 下。
[[ -d "$HOME/.cache/lm-studio/bin" ]] && path+=("$HOME/.cache/lm-studio/bin")
[[ -d "$HOME/.lmstudio/bin" ]] && path+=("$HOME/.lmstudio/bin")

# 导出 PATH
export PATH

# ============================================
# Homebrew 环境（交互 shell 的探测，其它文件不要再重复）
# ============================================
# 放在 .zshenv：所有 shell（login/non-login、interactive/non-interactive）
# 都会加载它，所以在 zprofile / zshrc 里就不用再各探一次了。
#
# 这里只设路径（不执行 brew 命令，免得拖慢启动）。
# 需要**把 brew 环境拉进当前进程**的脚本用 scripts/macos/brew-env.zsh，
# 那是给非交互 / 子进程场景用的共享实现；两者判断同一批路径。
#
# 以前这套「先 /opt/homebrew 再 /usr/local」的判断在 4 个地方各写了一遍
# （zprofile、zshrc、brew-bootstrap.zsh、ghostty 的 GUI 启动脚本），
# 加一台新路径的机器就要改 4 处、漏一处就静默失效。
# 现在收敛成：本文件（交互 shell）+ brew-env.zsh（脚本）+ 一个必须例外的
# （brew-bootstrap 安装期鸡生蛋）。
#
# 做的事和 `brew shellenv` 一样：设 HOMEBREW_* 并把 bin 加到 PATH。
# 不直接 eval `brew shellenv` 是因为它在非交互 shell 里会拖慢启动，
# 而这里只需要路径信息。
#
# ⚠️ 探测条件**不能**写成 `if [[ -z "$HOMEBREW_PREFIX" ]]`。
# 那样等于假设「HOMEBREW_PREFIX 已设 ⇒ brew 环境已就绪」——这个假设不成立：
# 环境里可能有个 HOMEBREW_PREFIX（GUI 启动、脚本 export、继承来的），
# 而 PATH 里根本没有 brew 的 bin。此时整段被跳过，后果是：
#
#   - brew 命令找不到（PATH 没加）
#   - MANPATH / INFOPATH / CELLAR / REPOSITORY 全都没设
#
# 而且**不报错、没有任何线索**。登录 shell 有 zprofile 的 `brew shellenv`
# 兜底看不出来，但非登录交互 shell（tmux pane、ghostty 新 tab）不走
# zprofile → 直接坏。
#
# 所以：**先确定 prefix**（用已有的，没有才去探），再**逐项补齐缺的**。
# 每项各自判断，不再用一个总开关门住一整段。
if [[ -z "${HOMEBREW_PREFIX:-}" ]]; then
  if [[ -x "/opt/homebrew/bin/brew" ]]; then
    export HOMEBREW_PREFIX="/opt/homebrew"
  elif [[ -x "/usr/local/bin/brew" ]]; then
    export HOMEBREW_PREFIX="/usr/local"
  fi
fi

if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
  # 同理：不能因为变量已设就跳过。变量可能是空串或指错，一律按需补。
  [[ -z "${HOMEBREW_CELLAR:-}" ]] && export HOMEBREW_CELLAR="$HOMEBREW_PREFIX/Cellar"

  # ⚠️ HOMEBREW_REPOSITORY 在 Apple Silicon 上等于 prefix（/opt/homebrew），
  # 但在 Intel 上是 prefix 下的 Homebrew（/usr/local/Homebrew）—— 写死成
  # `$HOMEBREW_PREFIX` 在 Intel 机器上会指错。按 ARCH 分辨。
  if [[ -z "${HOMEBREW_REPOSITORY:-}" ]]; then
    if [[ "$(uname -m)" == "arm64" ]]; then
      export HOMEBREW_REPOSITORY="$HOMEBREW_PREFIX"
    else
      export HOMEBREW_REPOSITORY="$HOMEBREW_PREFIX/Homebrew"
    fi
  fi

  # PATH：只看 brew 的 bin 在不在 PATH 里，不看 HOMEBREW_PREFIX 设没设。
  # （typeset -U path 会去重，所以重复经过这里也不会累积。）
  if [[ -d "$HOMEBREW_PREFIX/bin" ]]; then
    [[ ":$PATH:" == *":$HOMEBREW_PREFIX/bin:"* ]] || path=("$HOMEBREW_PREFIX/bin" $path)
  fi
  if [[ -d "$HOMEBREW_PREFIX/sbin" ]]; then
    [[ ":$PATH:" == *":$HOMEBREW_PREFIX/sbin:"* ]] || path+=("$HOMEBREW_PREFIX/sbin")
  fi

  # man / info 页路径（brew shellenv 也会设，非登录 shell 不走 .zprofile，
  # 所以这里补上，否则 man 找不到 brew 装的工具手册）。
  # 同样按需补 —— 已经指对了就不再叠一次，免得 MANPATH 越跑越长。
  [[ "${MANPATH:-}" != *"$HOMEBREW_PREFIX/share/man"* ]] \
    && export MANPATH="$HOMEBREW_PREFIX/share/man:${MANPATH:-}"
  [[ "${INFOPATH:-}" != *"$HOMEBREW_PREFIX/share/info"* ]] \
    && export INFOPATH="$HOMEBREW_PREFIX/share/info:${INFOPATH:-}"
fi

# ============================================
# 其他核心环境变量
# ============================================
# Don't clear the screen after quitting a manual page
export MANPAGER="less -X"
