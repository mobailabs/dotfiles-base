#!/usr/bin/env zsh

# ============================================
# Powerlevel10k instant prompt（**必须在最顶部**）
# ============================================
# p10k 的 instant prompt 让提示符**先画出来**，插件在后台继续加载 ——
# 这是 p10k 消除启动延迟的关键。代价：它要求这段**紧贴 zshrc 顶部**
# （在 source 任何别的东西之前），否则 p10k 会放弃并打印一段警告。
#
# 到这儿时终端还什么都不能打印。p10k 会在必要时自己把终端程序缓存起来。
# 想关掉 instant prompt：p10k.zsh 里设 POWERLEVEL9K_INSTANT_PROMPT=off，
# 并删掉本段。
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ============================================
# Homebrew 环境（要先于 oh-my-zsh，因为 fpath 要在 compinit 之前就位）
# ============================================
# .zshenv 已经设好 HOMEBREW_PREFIX（所有 shell 都加载，且先于本文件）。
# zsh-completions 提供 brew 装的额外补全定义；它必须在 oh-my-zsh 的
# compinit 运行**之前**把目录加进 fpath，否则不会生效。
if [[ -n "${HOMEBREW_PREFIX:-}" && -d "$HOMEBREW_PREFIX/share/zsh-completions" ]]; then
  fpath=("$HOMEBREW_PREFIX/share/zsh-completions" $fpath)
fi

# ============================================
# Oh My Zsh 加载
# ============================================
# 性能优化：跳过一些检查以加快启动速度
DISABLE_UPDATE_PROMPT=true
DISABLE_AUTO_UPDATE=false

[[ -f ~/.oh-my-zsh.sh ]] && source ~/.oh-my-zsh.sh

# ============================================
# 加载自定义配置文件
# ============================================
# exports - 应用特定环境变量
[[ -f ~/.exports ]] && source ~/.exports

# aliases - 命令别名
[[ -f ~/.aliases ]] && source ~/.aliases

# functions - 自定义函数
[[ -f ~/.funcs ]] && source ~/.funcs

# envconfig - 环境配置
[[ -f ~/.envconfig ]] && source ~/.envconfig

# OS config - 公共仓库提供的按平台覆盖（可选）
[[ -f "$HOME/.config/dotfiles/os.zsh" ]] && source "$HOME/.config/dotfiles/os.zsh"

# 本地片段 - 用户 / macview 往 conf.d 放的补充配置（公开仓库不认识里面是什么）
for _f in "$HOME/.config/dotfiles/conf.d"/*.zsh(N); do
  source "$_f"
done
unset _f

# ============================================
# Homebrew prefix
# ============================================
# 探测在 .zshenv 里（所有 shell 都加载，且先于本文件）。
# 这里**不再重复判断 /opt/homebrew** —— 以前这里又写了一份兜底，
# 不仅和 .zshenv 重复，还漏了 Intel 的 /usr/local。
# 如果 HOMEBREW_PREFIX 到这里还是空，说明确实没装 brew，
# 后面所有用了 $HOMEBREW_PREFIX 的路径判断自然会跳过。

# ============================================
# 工具初始化（只在交互式 shell 中）
# ============================================
if [[ -o interactive ]]; then
  # 禁用 Ctrl+S / Ctrl+Q 流量控制 (防止误按导致终端冻结)
  [[ -t 0 ]] && stty -ixon || true

  # GPG: pinentry needs correct TTY
  if [[ -t 1 ]]; then
    export GPG_TTY="$(tty 2>/dev/null || true)"
  fi

  # zoxide - 智能目录跳转
  if command -v zoxide &>/dev/null; then
    eval "$(zoxide init zsh)"
  fi

  # mise - 版本管理器
  if command -v mise &>/dev/null; then
    eval "$(mise activate zsh)"
  fi

  # fzf - 模糊查找器（如果通过 Homebrew 安装）
  if [[ -f "$HOMEBREW_PREFIX/opt/fzf/shell/completion.zsh" ]]; then
    source "$HOMEBREW_PREFIX/opt/fzf/shell/completion.zsh"
  fi
  if [[ -f "$HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.zsh" ]]; then
    source "$HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.zsh"
  fi
fi

# ============================================
# Zsh 插件加载（通过 Homebrew 安装）
# ============================================
# 这里 source 的插件都在 packages/macos/brew-cli.txt 里声明。
# 两对竞品各只启用一个（另一个不在清单里，装都不会装）：
#   zsh-autosuggestions        ← 启用（基于历史建议，快）
#     vs zsh-autocomplete      ← 不装（实时补全更强但更慢，与上面冲突）
#   zsh-syntax-highlighting    ← 启用（且必须最后加载）
#     vs zsh-fast-syntax-highlighting ← 不装（与上面冲突）

# zsh-autosuggestions（基于历史的快速建议）
if [[ -f "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  # 配置建议颜色（可选）
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
fi

# zsh-history-substring-search（历史搜索增强）
if [[ -f "$HOMEBREW_PREFIX/share/zsh-history-substring-search/zsh-history-substring-search.zsh" ]]; then
  source "$HOMEBREW_PREFIX/share/zsh-history-substring-search/zsh-history-substring-search.zsh"
  # 绑定上下箭头键
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
fi

# zsh-syntax-highlighting（语法高亮，必须最后加载）
if [[ -f "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# ============================================
# Powerlevel10k 提示符（在**所有插件之后**加载）
# ============================================
# 主题文件从 brew 的落点 source（`brew install powerlevel10k` 装的）。
# ⚠️ 顺序：必须在 zsh-autosuggestions / syntax-highlighting **之后** ——
# p10k 自己接管提示符，早于插件加载会和它们抢那几行。
# 走 brew 而不是 OmZ 主题目录：brew 能升级、能对账（macview 看得见）。
#
# 配置（~/.p10k.zsh）在下面单独 source：它引用 p10k 的函数，所以要
# 在主题之后。两者都缺就什么都不做（没装 p10k 的机器照常用，无报错）。
if [[ -n "${HOMEBREW_PREFIX:-}" && -f "$HOMEBREW_PREFIX/share/powerlevel10k/powerlevel10k.zsh-theme" ]]; then
  source "$HOMEBREW_PREFIX/share/powerlevel10k/powerlevel10k.zsh-theme"
  # 用户自己的 p10k 配置（仓库里的 p10k.zsh 链接过来）。p10k 官方推荐
  # 「config 文件单独 source」——见 p10k.zsh 末尾的 POWERLEVEL9K_CONFIG_FILE。
  [[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh
fi

# ============================================
# SSH helper
# ============================================
if [[ -f "$HOME/.zsh/zsh-ssh/zsh-ssh.zsh" ]]; then
  source "$HOME/.zsh/zsh-ssh/zsh-ssh.zsh"
fi

# ============================================
# Bun 补全
# ============================================
if [[ -s "$HOME/.bun/_bun" ]]; then
  source "$HOME/.bun/_bun"
fi

# ============================================
# 历史记录配置
# ============================================
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY          # 记录时间戳
setopt HIST_EXPIRE_DUPS_FIRST    # 优先删除重复的历史记录
setopt HIST_IGNORE_DUPS          # 不记录连续重复的命令
setopt HIST_IGNORE_SPACE         # 忽略以空格开头的命令
setopt HIST_VERIFY               # 历史扩展时先显示，不立即执行
setopt SHARE_HISTORY             # 在多个 shell 之间共享历史记录
setopt HIST_REDUCE_BLANKS        # 删除多余的空格
setopt HIST_FIND_NO_DUPS         # 历史搜索时不显示重复项

# ============================================
# Zsh 选项
# ============================================
setopt AUTO_CD                   # 输入目录名自动 cd
setopt AUTO_PUSHD                # cd 时自动 pushd
setopt PUSHD_IGNORE_DUPS         # pushd 时忽略重复目录
setopt CORRECT                   # 命令拼写纠正
setopt INTERACTIVE_COMMENTS      # 允许在交互式 shell 中使用注释
setopt NO_BEEP                   # 禁用蜂鸣声
setopt MULTIOS                   # 允许多重重定向

# ============================================
# 键绑定
# ============================================
# 使用 Emacs 风格的键绑定（或者使用 bindkey -v 来使用 Vi 风格）
bindkey -e

# 额外的有用键绑定
bindkey '^[[H' beginning-of-line      # Home 键
bindkey '^[[F' end-of-line            # End 键
bindkey '^[[3~' delete-char           # Delete 键
bindkey '^[[1;5C' forward-word        # Ctrl+Right 前进一个词
bindkey '^[[1;5D' backward-word       # Ctrl+Left 后退一个词

# ============================================
# 补全（compinit）
# ============================================
# 不要在这里手动跑 compinit —— Oh My Zsh 已经跑过了（在 source $ZSH/oh-my-zsh.sh 时）。
# 再跑一次是重复工作，还可能和 OmZ 的补全缓存打架。
#
# 想让自定义补全目录生效：把目录**加进 fpath，且要在 oh-my-zsh 之前**。
# 例子见本文件顶部 zsh-completions 的 fpath 那一段。
#
# （本文件以前留了一段注释掉的 `compinit` 延迟加载示例，用的是
#   `${ZDOTDIR}/.zcompdump` —— 但 ZDOTDIR 这里从没设过，那段照抄会指错路径，
#   而且是和 OmZ 重复的第二种补全初始化。已删。）

# ============================================
# 启动时间测试（调试用）
# ============================================
# 测量 shell 启动时间
# 使用方法：
#   1. 在文件顶部添加：zmodload zsh/zprof
#   2. 在文件底部取消下面的注释
#   3. 重启 shell 查看性能分析
# zprof

[[ -f "$HOME/.config/tmux/aliases.sh" ]] && source "$HOME/.config/tmux/aliases.sh"

# PATH 里的 npm / LM Studio 路径已收进 ~/.zshenv（单一归属，见那里的注释）。
# 这里不再重复 —— 重复的结果是两处不同步，且 zshrc 每次都会被走一遍。

export PATH

