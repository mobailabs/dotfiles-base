# 启动时间测试（调试用）
# ============================================
# 测量 shell 启动时间
# 使用方法：
#   1. 在文件顶部添加：zmodload zsh/zprof
#   2. 在文件底部取消下面的注释
#   3. 重启 shell 查看性能分析
# zprof

if [[ -f "$HOME/.config/tmux/aliases.sh" ]]; then
  source "$HOME/.config/tmux/aliases.sh"
fi
export PATH="$HOME/.npm-global/bin:$PATH"

